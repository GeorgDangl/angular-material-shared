{
  "compileOnSave": false,
  "angularCompilerOptions": {
    "strictTemplates": true
  },
  "compilerOptions": {
    "importHelpers": true,
    "esModuleInterop": true,
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "module": "es2022",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "target": "ES2022",
    "types": ["jasmine", "node"],
    "typeRoots": [
      "node_modules/@types"
    ],
    "paths": {
      "@dangl/angular-material-shared/*": [
        "./projects/angular-material-shared/*"
      ],
      "@dangl/angular-material-shared": [
        "./projects/angular-material-shared"
      ]
    },
    "useDefineForClassFields": false
  }
}
