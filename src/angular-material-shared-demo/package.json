{
  "name": "angular-material-shared-demo",
  "version": "0.0.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "postinstall": "npm run copy:icons && npm run copy:plugins && npm run copy:skins && npm run copy:themes && npm run copy:langs && npm run copy:models",
    "copy:icons": "xcopy /I /E /Y node_modules\\tinymce\\icons src\\assets\\tinymce-assets\\icons",
    "copy:plugins": "xcopy /I /E /Y node_modules\\tinymce\\plugins src\\assets\\tinymce-assets\\plugins",
    "copy:skins": "xcopy /I /E /Y node_modules\\tinymce\\skins src\\assets\\tinymce-assets\\skins",
    "copy:themes": "xcopy /I /E /Y node_modules\\tinymce\\themes src\\assets\\tinymce-assets\\themes",
    "copy:langs": "xcopy /I /E /Y node_modules\\tinymce-i18n\\langs5 src\\assets\\tinymce-assets\\langs",
    "copy:models": "xcopy /I /E /Y node_modules\\tinymce\\models src\\assets\\tinymce-assets\\models",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test --watch=false",
    "build:library": "ng-packagr -p  projects/angular-material-shared/ng-package.json && xcopy projects\\angular-material-shared\\src\\styles dist\\angular-material-shared\\styles\\ /E",
    "test:ci": "ng test angular-material-shared --no-watch --karma-config projects/angular-material-shared/karma-ci.conf.js",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.0.0",
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/material": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-browser-dynamic": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@tinymce/tinymce-angular": "^9.0.0",
    "core-js": "^3.21.0",
    "rxjs": "^7.8.1",
    "tinymce": "^7.0.0",
    "tinymce-i18n": "^24.3.11",
    "tslib": "^2.6.0"
  },
  "devDependencies": {
    "@angular-devkit/schematics": "^22.0.0",
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@angular/language-service": "^22.0.0",
    "@eslint/js": "^10.0.1",
    "@types/jasmine": "^5.1.0",
    "@types/node": "^22.0.0",
    "angular-eslint": "22.1.0",
    "eslint": "^10.6.0",
    "jasmine-core": "^5.1.0",
    "jasmine-spec-reporter": "^7.0.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "karma-junit-reporter": "^2.0.1",
    "ng-packagr": "^22.0.0",
    "puppeteer": "^24.0.0",
    "ts-node": "~10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.62.1"
  }
}